# Domain & Server Setup
# Public domain pointing to your server (ports 80 and 443 must be reachable)
DOMAIN_NAME=your_domain_here
# Timezone for the n8n schedule triggers (e.g. UTC, Africa/Casablanca)
GENERIC_TIMEZONE=UTC

# External APIs
NEWS_API_KEY=your_newsapi_key_here
TAVILY_API_KEY=your_tavily_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TLS (Caddy issues certificates through ZeroSSL)
ZERO_SSL_API_KEY=your_zero_ssl_api_key_here
# Email used to register the certificate account
ACME_EMAIL=your_email_here

# Meta / Instagram Graph API
META_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
# Long-lived token; it expires, so refresh it periodically
META_ACCESS_TOKEN=your_meta_access_token_here
